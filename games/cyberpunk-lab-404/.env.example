# Required for live NPC dialogue and interrogation scoring.
# Free tier, no credit card required — get a key at https://aistudio.google.com/apikey
# Without it the game still runs: characters fall back to canned lines and the
# scripted trust rules in app/api/npc/evaluate carry the critical path.
GOOGLE_GENERATIVE_AI_API_KEY=

# Only needed for the Capacitor/static build, where there is no local API.
# Point it at your deployed web app, e.g. https://your-app.vercel.app
NEXT_PUBLIC_API_BASE_URL=
