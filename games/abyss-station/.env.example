# Optional. With a key, AI bots chat in meetings using Gemini (free tier at
# https://aistudio.google.com/apikey). Without one they use canned lines but
# still move, do tasks, kill, sabotage and vote.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. When set, hosting/joining rooms and Gemini bot chat need an invite
# code, checked with eonelabs.my; Play vs bots (canned lines) stays public.
# Unset: everything unlocked.
# ABYSS_VERIFY_TOKEN=
# ABYSS_VERIFY_URL=https://eonelabs.my/api/internal/abyss/verify-code

# Testing helpers
# ABYSS_MIN_PLAYERS=2
# ABYSS_TASKS=2
